<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Startsida</title>
    <link rel="stylesheet" href="css/styles.css">
</head>

<body>
    <div class="container">
        <main>
            <div class="content-wrapper">
                <h1>Sparade kurser</h1>
                <table>
                    <thead>
                        <tr>
                            <th>Kurskod</th>
                            <th>Namn</th>
                            <th>Kursplan</th>
                            <th>Progression</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% courses.forEach(course=> { %>
                            <tr>
                                <td>
                                    <%= course.coursecode %>
                                </td>
                                <td>
                                    <%= course.coursename %>
                                </td>
                                <td><a href="<%= course.syllabus %>">Kursplan</a></td>
                                <td>
                                    <%= course.progression %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>

</html>